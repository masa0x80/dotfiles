[core]
  autocrlf = false
  excludesfile = ~/.config/git/ignore
  pager = gitpager
  hooksPath = ~/.config/git/hooks
  quotepath = false
[init]
  defaultBranch = main
[include]
  path = ~/.config.local/git/config
[push]
  default = current
  autoSetupRemote = true
[commit]
  verbose = true
[merge]
  ff = false
  conflictStyle = zdiff3
[fetch]
  prune = true
[pull]
  rebase = true
[rebase]
  autosquash = true
  autoStash = true
  updateRefs = true
[rerere]
  enabled = true
[branch]
  sort = -committerdate
[credential]
  helper = osxkeychain
[pager]
  show = "gitpager --pattern='^(commit|added|deleted|modified):? '"
  log = "gitpager --pattern='^(commit|added|deleted|modified):? '"
  branch = cat
  difftool = true
[color]
  diff = auto
  status = auto
  branch = auto
  interactive = auto
[alias]
  initial-commit = commit --allow-empty -m 'Initial commit'
  issue-id = !git rev-parse --abbrev-ref @ | grep -Eo '([A-Z0-9_]+-[0-9]+|[0-9]*)' | head -n1
  current-branch = rev-parse --abbrev-ref HEAD
  default-branch = !git symbolic-ref --short refs/remotes/origin/HEAD | sed 's|^origin/||'
  fixup = !git commit --fixup $(git fzf) --no-verify
  delete-merged-branches = !git branch --no-color --merged | grep -E -v '^\\*|\\s(main|develop|master)$' | xargs git branch -d
[ghq]
  root = ~/.ghq
[harrow]
  disabled = true
[diff]
  tool = difftastic
  algorithm = histogram
  colorMoved = default
[diff "sopsdiffer"]
  textconv = sops -d
[difftool]
  prompt = false
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
