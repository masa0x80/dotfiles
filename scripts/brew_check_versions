#!/bin/bash

# バージョン付きで宣言した formula（"brew:openssl@4" など）のメジャーバージョンが上がったら知らせる
# NOTE: [bootstrap.packages] のキーには変数を使えないので、宣言中のバージョンはキーから読み取る
sed -n 's/^"brew:\([a-z0-9-]*@[0-9]*\)".*/\1/p' "$(dirname "$0")/../mise.toml" | while read -r declared; do
  name=${declared%@*}
  latest=$(brew info "$name" 2>/dev/null | sed -n '1s/^==> \([^:]*\):.*/\1/p')
  [ -z "$latest" ] || [ "$latest" = "$declared" ] || printf '\033[1;35m%s\033[0m\n' "NOTE: ${name} の最新は ${latest} です（mise.toml は ${declared}）"
done
